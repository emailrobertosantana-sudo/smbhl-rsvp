{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smbhl-rsvp",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_URL": "https://rsvp.smbhl.com",
    // Emails per calendar day (UTC) the Resend plan allows -- sub calls
    // defer to the next day once roster mail has what it needs (see
    // src/mail_queue.js, DAILY SEND CAP). Change here if the plan changes.
    "MAIL_DAILY_CAP": "90",
    // Payment reminders keep this many of the day's emails for the admin
    // alerts (src/index.js paymentReminderBudget).
    "PAYMENT_REMINDER_RESERVE": "10"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smbhl-rsvp",
      "database_id": "6f1838cf-30b0-4b4b-b9fe-716b61b961e4"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SHEETS_KV",
      "id": "e5af34ebf39b4c5d8851d7b071368a0e"
    }
  ],
  // The deployed version's id (env.CF_VERSION_METADATA.id): the cron's
  // schema guard remembers a clean check per version (src/schema_guard.js
  // checkSchemaForPass). A binding, so env.demo repeats it.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "env": {
    "demo": {
      "name": "notreligue-rsvp",
      "vars": {
        "PUBLIC_URL": "https://rsvp.notreligue.ca",
        "DEMO_ENV": "true",
        // Distinct from DEMO_ENV (which only means "non-production
        // deployment," used for the noindex/robots.txt behavior) --
        // this specifically marks "this deployment is the Notre Ligue
        // product Worker," so scheduled() below can route to the new,
        // independent league-reminder cron instead of SMBHL's own
        // runSchedule(), without depending on DEMO_ENV's unrelated
        // meaning (a future real-production league-product deployment
        // would set this without DEMO_ENV).
        "LEAGUE_PRODUCT": "true",
        // No daily caps here (caps batch, item 1a): this env block's vars
        // replace the top-level ones, so MAIL_DAILY_CAP, MAIL_HARD_DAILY_CAP
        // and PAYMENT_REMINDER_RESERVE are unset for Notre Ligue. Its limits
        // are src/mail_guard.js's: 25 a day to players for a free league,
        // and the five rules that pause a mistake.
        // Notre Ligue mail (From mail.notreligue.ca) goes through Cloudflare
        // Email Sending here, via the send_email binding below. SMBHL mail,
        // and every environment without this var, stays on Resend. See
        // src/mail_provider.js and the README's "Mail provider" section.
        "MAIL_PROVIDER": "cloudflare",
        // Notre Ligue billing (src/billing.js, docs/billing.md): the four
        // prices (CAD, tax exclusive) and the pinned Stripe API version.
        // Demo only: production gets none of these. The secrets
        // STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set with
        // wrangler secret put --env demo, never here.
        "STRIPE_PRICE_STANDARD_MONTHLY": "price_1ULpndA7Yxc2R6KsFeFMuVwP",
        "STRIPE_PRICE_STANDARD_YEARLY": "price_1ULpoZA7Yxc2R6KssVewqYes",
        "STRIPE_PRICE_PLUS_MONTHLY": "price_1ULpriA7Yxc2R6Ks8ETGyZaI",
        "STRIPE_PRICE_PLUS_YEARLY": "price_1ULpsiA7Yxc2R6KsSWuEJd5j",
        "STRIPE_API_VERSION": "2026-08-26.dahlia",
        // Billing launch (src/billing.js): every Notre Ligue league's trial
        // starts here (2 months). Demo only; SMBHL and production never
        // get one.
        "BILLING_LAUNCH_AT": "2026-10-02"
      },
      "send_email": [
        { "name": "SEND_EMAIL" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "notreligue-demo",
          "database_id": "87411a46-fc5f-414f-bd46-6ff26feb155f"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SHEETS_KV",
          "id": "28a2834f15814fcb84bb98f62f4919f1"
        }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // A genuinely separate cron trigger from SMBHL's own
      // (top-level triggers.crons, "*/5 * * * *") -- this env block's
      // own triggers REPLACE the top-level ones for this named
      // deployment (notreligue-rsvp) entirely, they don't merge with
      // or inherit from them, so this can never fire against or
      // alongside SMBHL's schedule. Every 15 minutes is frequent
      // enough to catch the 72h/24h/12h reminder windows (each hours
      // wide) with good precision without the cost of SMBHL's own
      // 5-minute interval, which exists for its own tighter
      // wave-based sub-call timing this feature doesn't need.
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "routes": [
        {
          "pattern": "rsvp.notreligue.ca",
          "custom_domain": true
        },
        {
          "pattern": "notreligue.ca",
          "custom_domain": true
        },
        // Redirected to notreligue.ca in code (src/index.js fetch).
        {
          "pattern": "www.notreligue.ca",
          "custom_domain": true
        }
      ]
    }
  }
}
